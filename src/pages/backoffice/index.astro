---
import Layout from '../../layouts/Layout.astro';
import TeacherManager from '../../components/backoffice/TeacherManager';
import FeedbackManager from '../../components/backoffice/FeedbackManager';
import { getAuthStore, extractCloudflareAccessEmail, authenticateDelegatedAdmin } from '../../lib/auth';
import { getConversationStore } from '../../lib/conversations';
import { ROOT_ADMIN_EMAILS } from 'astro:env/server';

const runtimeEnv = (Astro.locals as any)?.runtime?.env;
const db = runtimeEnv?.DB;
const authStore = getAuthStore(db);
const convStore = getConversationStore(db);

const sessionToken = Astro.cookies.get('maxister_session')?.value;
let user = null;

if (sessionToken) {
  user = await authStore.validateSession(sessionToken);
}

// If no valid session but Cloudflare Access header is present, auto-authenticate
if (!user || user.role !== 'root_admin') {
  const cfAccessEmail = extractCloudflareAccessEmail(Astro.request);
  if (cfAccessEmail) {
    const allowedEmails =
      ROOT_ADMIN_EMAILS ||
      runtimeEnv?.ROOT_ADMIN_EMAILS ||
      process.env.ROOT_ADMIN_EMAILS ||
      'admin@desde0.dev';
    const delegated = await authenticateDelegatedAdmin(cfAccessEmail, allowedEmails, authStore);
    if (delegated.authorized && delegated.user && delegated.sessionToken) {
      user = delegated.user;
      Astro.cookies.set('maxister_session', delegated.sessionToken, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        secure: import.meta.env.PROD,
        maxAge: 60 * 60 * 24 * 7,
      });
    }
  }
}

if (!user || user.role !== 'root_admin') {
  return Astro.redirect('/backoffice/login');
}

const teachers = await authStore.listTeachers();
const feedback = await convStore.listTeacherFeedback();
---

<Layout title="Panel de Administración — Backoffice Maxister">
  <div class="min-h-screen bg-[#141414] text-[#ececec] font-sans antialiased pb-16">
    {/* Backoffice Header */}
    <header class="h-16 px-6 flex items-center justify-between border-b border-white/10 bg-[#181818]/90 backdrop-blur-md sticky top-0 z-20 shadow-md">
      <div class="flex items-center gap-3">
        <div class="size-9 rounded-2xl bg-paradiso/20 border border-paradiso/30 flex items-center justify-center text-paradiso-300 text-base font-bold shadow-md shadow-paradiso/10">
          🏛️
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-sm font-bold text-white tracking-tight">Backoffice Central</h1>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-paradiso/15 text-paradiso-300 border border-paradiso/30 font-semibold font-mono">
              Root Admin
            </span>
          </div>
          <p class="text-[11px] text-white/50">{user?.email || 'admin@desde0.dev'}</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs text-white/80 hover:text-white border border-white/5 transition"
        >
          <span>Chat Studio</span>
          <span class="text-white/40">↗</span>
        </a>
        <button
          id="logout-btn"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-xs font-semibold text-red-400 border border-red-500/20 transition cursor-pointer"
        >
          <span>Cerrar Sesión</span>
        </button>
      </div>
    </header>

    {/* Main Container */}
    <main class="max-w-6xl mx-auto px-6 py-8 space-y-8">
      {/* Metrics Row */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-[#1c1c1c] border border-white/10 hover:border-white/20 transition shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-[11px] text-white/50 uppercase font-semibold tracking-wider">Profesores en Alta</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 font-mono">Staff</span>
          </div>
          <p class="text-3xl font-bold text-white mt-2">{teachers.length}</p>
          <p class="text-[11px] text-white/40 mt-1">Docentes verificados en la academia</p>
        </div>
        <div class="p-5 rounded-2xl bg-[#1c1c1c] border border-white/10 hover:border-paradiso/30 transition shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-[11px] text-white/50 uppercase font-semibold tracking-wider">Directrices en Memoria</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-paradiso/15 text-paradiso-300 font-mono">Feedback</span>
          </div>
          <p class="text-3xl font-bold text-paradiso-300 mt-2">{feedback.length}</p>
          <p class="text-[11px] text-white/40 mt-1">Pautas pedagógicas registradas</p>
        </div>
        <div class="p-5 rounded-2xl bg-[#1c1c1c] border border-white/10 hover:border-emerald-500/30 transition shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-[11px] text-white/50 uppercase font-semibold tracking-wider">Directrices Activas</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 font-mono">En Prompts</span>
          </div>
          <p class="text-3xl font-bold text-emerald-400 mt-2">
            {feedback.filter((f) => f.status === 'active').length}
          </p>
          <p class="text-[11px] text-white/40 mt-1">Inyectadas activamente en Maxister</p>
        </div>
      </div>

      {/* Tabs */}
      <div class="space-y-6">
        <div class="border-b border-white/10 flex gap-6 text-sm font-semibold">
          <button
            id="tab-btn-teachers"
            class="pb-3 border-b-2 border-paradiso text-white flex items-center gap-2 cursor-pointer"
          >
            <span>Profesores Verificados</span>
            <span class="text-[11px] px-2 py-0.2 rounded-full bg-white/10 text-white/80 font-normal">
              {teachers.length}
            </span>
          </button>
          <button
            id="tab-btn-feedback"
            class="pb-3 border-b-2 border-transparent text-white/50 hover:text-white/80 transition flex items-center gap-2 cursor-pointer"
          >
            <span>Memoria Estratégica & Feedback</span>
            <span class="text-[11px] px-2 py-0.2 rounded-full bg-white/5 text-white/60 font-normal">
              {feedback.length}
            </span>
          </button>
        </div>

        <div id="tab-content-teachers">
          <TeacherManager client:only="react" initialTeachers={teachers} />
        </div>

        <div id="tab-content-feedback" class="hidden">
          <FeedbackManager client:only="react" initialFeedback={feedback} />
        </div>
      </div>
    </main>
  </div>

  <script>
    const btnTeachers = document.getElementById('tab-btn-teachers');
    const btnFeedback = document.getElementById('tab-btn-feedback');
    const contentTeachers = document.getElementById('tab-content-teachers');
    const contentFeedback = document.getElementById('tab-content-feedback');
    const logoutBtn = document.getElementById('logout-btn');

    btnTeachers?.addEventListener('click', () => {
      btnTeachers.className = 'pb-3 border-b-2 border-paradiso text-white flex items-center gap-2 cursor-pointer';
      if (btnFeedback) btnFeedback.className = 'pb-3 border-b-2 border-transparent text-white/50 hover:text-white/80 transition flex items-center gap-2 cursor-pointer';
      contentTeachers?.classList.remove('hidden');
      contentFeedback?.classList.add('hidden');
    });

    btnFeedback?.addEventListener('click', () => {
      btnFeedback.className = 'pb-3 border-b-2 border-paradiso text-white flex items-center gap-2 cursor-pointer';
      if (btnTeachers) btnTeachers.className = 'pb-3 border-b-2 border-transparent text-white/50 hover:text-white/80 transition flex items-center gap-2 cursor-pointer';
      contentFeedback?.classList.remove('hidden');
      contentTeachers?.classList.add('hidden');
    });

    logoutBtn?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/backoffice/login';
    });
  </script>
</Layout>
