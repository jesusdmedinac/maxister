---
import Layout from '../../layouts/Layout.astro';
import TeacherManager from '../../components/backoffice/TeacherManager';
import FeedbackManager from '../../components/backoffice/FeedbackManager';
import { defaultAuthStore } from '../../lib/auth';
import { defaultConversationStore } from '../../lib/conversations';

const sessionToken = Astro.cookies.get('maxister_session')?.value;
let user = null;

if (sessionToken) {
  user = await defaultAuthStore.validateSession(sessionToken);
}

if (!user || user.role !== 'root_admin') {
  return Astro.redirect('/backoffice/login');
}

const teachers = await defaultAuthStore.listTeachers();
const feedback = await defaultConversationStore.listTeacherFeedback();
---

<Layout title="Panel de Administración — Backoffice Maxister">
  <div className="min-h-screen bg-[#141414] text-[#ececec] font-sans antialiased">
    {/* Backoffice Header */}
    <header className="h-16 px-6 flex items-center justify-between border-b border-white/5 bg-[#181818] sticky top-0 z-20">
      <div className="flex items-center gap-3">
        <div className="size-8 rounded-xl bg-paradiso/20 flex items-center justify-center text-paradiso-300 font-bold">
          🏛️
        </div>
        <div>
          <h1 className="text-sm font-bold text-white flex items-center gap-2">
            <span>Backoffice Central</span>
            <span className="text-[10px] px-2 py-0.5 rounded-full bg-paradiso/10 text-paradiso-300 border border-paradiso/20">
              Root Admin
            </span>
          </h1>
          <p className="text-[11px] text-white/50">Academia Desde0</p>
        </div>
      </div>

      <div className="flex items-center gap-4">
        <a href="/" className="text-xs text-white/60 hover:text-white transition">
          Ver Chat Studio
        </a>
        <button
          id="logout-btn"
          className="px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold text-white/80 transition"
        >
          Cerrar Sesión
        </button>
      </div>
    </header>

    {/* Main Container */}
    <main className="max-w-6xl mx-auto px-6 py-8 space-y-8">
      {/* Metrics Row */}
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div className="p-5 rounded-2xl bg-[#1c1c1c] border border-white/5">
          <span className="text-[11px] text-white/50 uppercase font-semibold tracking-wider">Profesores en Alta</span>
          <p className="text-2xl font-bold text-white mt-1">{teachers.length}</p>
        </div>
        <div className="p-5 rounded-2xl bg-[#1c1c1c] border border-white/5">
          <span className="text-[11px] text-white/50 uppercase font-semibold tracking-wider">Directrices en Memoria</span>
          <p className="text-2xl font-bold text-paradiso-300 mt-1">{feedback.length}</p>
        </div>
        <div className="p-5 rounded-2xl bg-[#1c1c1c] border border-white/5">
          <span className="text-[11px] text-white/50 uppercase font-semibold tracking-wider">Directrices Activas</span>
          <p className="text-2xl font-bold text-emerald-400 mt-1">
            {feedback.filter((f) => f.status === 'active').length}
          </p>
        </div>
      </div>

      {/* Tabs */}
      <div className="space-y-6">
        <div className="border-b border-white/10 flex gap-6 text-sm font-semibold">
          <button
            id="tab-btn-teachers"
            className="pb-3 border-b-2 border-paradiso text-white"
          >
            Profesores Verificados ({teachers.length})
          </button>
          <button
            id="tab-btn-feedback"
            className="pb-3 border-b-2 border-transparent text-white/50 hover:text-white/80 transition"
          >
            Memoria Estratégica & Feedback ({feedback.length})
          </button>
        </div>

        <div id="tab-content-teachers">
          <TeacherManager client:only="react" initialTeachers={teachers} />
        </div>

        <div id="tab-content-feedback" className="hidden">
          <FeedbackManager client:only="react" initialFeedback={feedback} />
        </div>
      </div>
    </main>
  </div>

  <script>
    const btnTeachers = document.getElementById('tab-btn-teachers');
    const btnFeedback = document.getElementById('tab-btn-feedback');
    const contentTeachers = document.getElementById('tab-content-teachers');
    const contentFeedback = document.getElementById('tab-content-feedback');
    const logoutBtn = document.getElementById('logout-btn');

    btnTeachers?.addEventListener('click', () => {
      btnTeachers.className = 'pb-3 border-b-2 border-paradiso text-white';
      if (btnFeedback) btnFeedback.className = 'pb-3 border-b-2 border-transparent text-white/50 hover:text-white/80 transition';
      contentTeachers?.classList.remove('hidden');
      contentFeedback?.classList.add('hidden');
    });

    btnFeedback?.addEventListener('click', () => {
      btnFeedback.className = 'pb-3 border-b-2 border-paradiso text-white';
      if (btnTeachers) btnTeachers.className = 'pb-3 border-b-2 border-transparent text-white/50 hover:text-white/80 transition';
      contentFeedback?.classList.remove('hidden');
      contentTeachers?.classList.add('hidden');
    });

    logoutBtn?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/backoffice/login';
    });
  </script>
</Layout>
