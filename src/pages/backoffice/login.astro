---
import Layout from '../../layouts/Layout.astro';
const isDev = import.meta.env.DEV;
---

<Layout title="Backoffice Acceso Root — Maxister">
  <div class="flex min-h-screen items-center justify-center bg-[#141414] px-4 font-sans text-[#ececec]">
    <div class="w-full max-w-sm rounded-3xl border border-white/10 bg-[#1c1c1c] p-7 shadow-2xl">
      <div class="mb-6 text-center">
        <div class="mx-auto mb-3 flex size-12 items-center justify-center rounded-2xl bg-paradiso/20 border border-paradiso/30 text-paradiso-300 text-xl font-bold shadow-lg shadow-paradiso/10">
          🏛️
        </div>
        <h1 class="text-xl font-bold text-white tracking-tight">Backoffice Root Admin</h1>
        <p class="mt-1 text-xs text-white/50">
          Gobernanza de profesores y memoria estratégica tutorizada
        </p>
      </div>

      <div id="error-msg" class="hidden mb-4 rounded-xl border border-red-500/20 bg-red-500/10 p-3 text-xs text-red-400"></div>

      {isDev ? (
        <div class="space-y-4">
          <div class="rounded-xl border border-amber-500/20 bg-amber-500/10 p-3 text-xs text-amber-300">
            <span class="font-bold">⚡ Modo Desarrollo Detectado:</span>
            <p class="mt-1 text-[11px] text-amber-200/70">
              Autenticación delegada simulada para desarrollo local sin requerir túnel Cloudflare Access.
            </p>
          </div>

          <button
            type="button"
            id="dev-login-btn"
            class="w-full rounded-xl bg-paradiso py-2.5 text-xs font-bold text-white shadow-lg shadow-paradiso/20 hover:bg-paradiso-600 active:scale-[0.98] transition cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Ingresar como Root Admin (Dev)</span>
            <span>→</span>
          </button>

          <div class="relative flex items-center justify-center my-3">
            <div class="border-t border-white/10 w-full"></div>
            <span class="bg-[#1c1c1c] px-2 text-[10px] text-white/30 uppercase tracking-wider">o credenciales</span>
          </div>

          <form id="login-form" class="space-y-3">
            <div>
              <label class="block text-xs font-medium text-white/70 mb-1">Correo Administrador</label>
              <input
                type="email"
                id="email"
                placeholder="admin@desde0.dev"
                class="w-full rounded-xl border border-white/10 bg-[#121212] px-3.5 py-2 text-xs text-white placeholder-white/30 outline-none focus:border-paradiso focus:ring-1 focus:ring-paradiso transition"
              />
            </div>
            <div>
              <label class="block text-xs font-medium text-white/70 mb-1">Contraseña (opcional en Dev)</label>
              <input
                type="password"
                id="password"
                placeholder="••••••••••••"
                class="w-full rounded-xl border border-white/10 bg-[#121212] px-3.5 py-2 text-xs text-white placeholder-white/30 outline-none focus:border-paradiso focus:ring-1 focus:ring-paradiso transition"
              />
            </div>
            <button
              type="submit"
              id="submit-btn"
              class="w-full rounded-xl bg-white/10 py-2 text-xs font-semibold text-white/80 hover:bg-white/20 transition cursor-pointer"
            >
              Ingresar con Datos Específicos
            </button>
          </form>
        </div>
      ) : (
        <div class="space-y-4 text-center">
          <div class="rounded-xl border border-blue-500/20 bg-blue-500/10 p-4 text-xs text-blue-300">
            <p class="font-bold text-sm mb-1">🛡️ Cloudflare Zero Trust</p>
            <p class="text-[11px] text-blue-200/80 leading-relaxed">
              El acceso al Backoffice en producción está estrictamente protegido por Cloudflare Access con autenticación delegada por SSO/MFA.
            </p>
          </div>
          <a
            href="/backoffice"
            class="block w-full rounded-xl bg-paradiso py-2.5 text-xs font-bold text-white shadow-lg shadow-paradiso/20 hover:bg-paradiso-600 transition"
          >
            Verificar Identidad en Cloudflare
          </a>
        </div>
      )}

      <div class="mt-6 text-center text-[11px] text-white/40">
        <a href="/" class="hover:text-paradiso-300 transition">← Volver al chat de Maxister</a>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('login-form');
    const devLoginBtn = document.getElementById('dev-login-btn');
    const errorMsg = document.getElementById('error-msg');
    const submitBtn = document.getElementById('submit-btn');

    devLoginBtn?.addEventListener('click', async () => {
      errorMsg?.classList.add('hidden');
      if (devLoginBtn) devLoginBtn.setAttribute('disabled', 'true');

      try {
        const res = await fetch('/api/backoffice/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ devMode: true }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Acceso de desarrollo denegado');
        window.location.href = '/backoffice';
      } catch (err: any) {
        if (errorMsg) {
          errorMsg.textContent = err.message || 'Error de acceso';
          errorMsg.classList.remove('hidden');
        }
      } finally {
        if (devLoginBtn) devLoginBtn.removeAttribute('disabled');
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg?.classList.add('hidden');
      if (submitBtn) submitBtn.setAttribute('disabled', 'true');

      const email = (document.getElementById('email') as HTMLInputElement)?.value;
      const password = (document.getElementById('password') as HTMLInputElement)?.value;

      try {
        const res = await fetch('/api/backoffice/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, devMode: !password }),
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Credenciales inválidas');

        window.location.href = '/backoffice';
      } catch (err: any) {
        if (errorMsg) {
          errorMsg.textContent = err.message || 'Error de acceso';
          errorMsg.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.removeAttribute('disabled');
      }
    });
  </script>
</Layout>
