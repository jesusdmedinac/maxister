# Clave de API de Google Gemini (requerida para respuestas en vivo)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Modelo de Gemini a utilizar (opcional, por defecto: gemini-flash-lite-latest)
GEMINI_MODEL="gemini-flash-lite-latest"

# Root Administrator Governance (Cloudflare Environment Variables)
ROOT_ADMIN_EMAIL="admin@desde0.internal"
ROOT_ADMIN_PASSWORD="YourSecureAdminPassword123"
