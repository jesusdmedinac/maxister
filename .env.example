# ==============================================================================
# Maxister - Environment Variables & Secrets
# ==============================================================================
# Copy this file to .env and fill in your secrets:
# cp .env.example .env

# Google Gemini API Key (Required for AI responses)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=""

# Gemini Model identifier (Defaults to gemini-flash-lite-latest)
GEMINI_MODEL="gemini-flash-lite-latest"

# Maxister Root Administrator (Backoffice Governance)
# Configure these credentials to access /backoffice and manage teachers/feedback:
ROOT_ADMIN_EMAIL="admin@desde0.dev"
ROOT_ADMIN_PASSWORD="superSecretRootPassword123!"
